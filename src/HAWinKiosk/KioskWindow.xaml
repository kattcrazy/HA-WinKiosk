<Window x:Class="HAWinKiosk.KioskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HAWinKiosk"
        xmlns:settings="clr-namespace:HAWinKiosk.Settings"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="HA WinKiosk"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource Theme.Kiosk.Bg}"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <!-- Colours applied at runtime from ThemePalette.cs -->
        <!-- Page title: dialog chrome only -->
        <Style x:Key="SettingsPageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Settings.Fg}"/>
        </Style>
        <!-- Section: Config, Gestures, Pin, MQTT -->
        <Style x:Key="SettingsSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Settings.Fg}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Sub: Sensors, Commands (under MQTT) -->
        <Style x:Key="SettingsSubSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Settings.FgSub}"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <!-- Item: field labels (above inputs) -->
        <Style x:Key="SettingsItemLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Settings.FgMuted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Item: label beside toggle (same tier as SettingsItemLabel) -->
        <Style x:Key="SettingsToggleRowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Settings.FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- Hint text under toggles / fields -->
        <Style x:Key="SettingsHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Settings.FgSub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsSliderDecreaseRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Theme.Accent}"
                                CornerRadius="3,0,0,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource Theme.Toggle.ThumbOn}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBackground"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource Theme.Toggle.TrackOff}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SettingsSliderDecreaseRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SettingsSliderRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackBackground" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="KioskPanel" Background="{DynamicResource Theme.Kiosk.Bg}">
            <Grid>
                <wv2:WebView2 x:Name="WebView"/>
                <local:KioskGestureFallbackOverlay x:Name="GestureFallbackOverlay"
                                                   Panel.ZIndex="500"/>
            </Grid>
        </Grid>

        <Popup x:Name="BreakingChangesBannerPopup"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None"
               Placement="AbsolutePoint">
            <Border x:Name="BreakingChangesBanner"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Theme.BreakingChanges.Bg}"
                    BorderBrush="{DynamicResource Theme.BreakingChanges.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10,6,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7BA;"
                               FontSize="18"
                               Foreground="{DynamicResource Theme.BreakingChanges.Icon}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="The current version of HA WinKiosk includes breaking changes. Make sure to check the releases page for any changes required."
                               FontSize="12"
                               Foreground="{DynamicResource Theme.BreakingChanges.Fg}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Dismiss"
                            Click="BreakingChangesBannerDismiss_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="4">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE711;"
                                               FontSize="12"
                                               Foreground="{DynamicResource Theme.BreakingChanges.Icon}"
                                               Opacity="0.85"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="SettingsButtonPopup"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None"
               Placement="AbsolutePoint">
            <Button Style="{StaticResource SettingsButton}"
                    Background="{DynamicResource Theme.Kiosk.SettingsButtonBg}"
                    Click="SettingsButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE713;"
                           FontSize="18"
                           Foreground="{DynamicResource Theme.Accent.Fg}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Button>
        </Popup>

        <Popup x:Name="CustomButtonPopup"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None"
               Placement="AbsolutePoint">
            <Button Style="{StaticResource SettingsButton}"
                    Background="{DynamicResource Theme.Kiosk.SettingsButtonBg}"
                    Click="CustomButton_Click">
                <materialIcons:MaterialIcon x:Name="CustomButtonIcon"
                                            Kind="ButtonPointer"
                                            Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource Theme.Accent.Fg}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>
            </Button>
        </Popup>

        <Grid x:Name="SettingsPanel"
              Background="{DynamicResource Theme.Settings.PanelBg}"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <ScrollViewer x:Name="SettingsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource Theme.Settings.CardBg}"
                        BorderBrush="{DynamicResource Theme.Settings.CardBorder}"
                        BorderThickness="1.3"
                        CornerRadius="8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="0,0,0,0"
                        MinHeight="{Binding ViewportHeight, ElementName=SettingsScrollViewer}">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Full-width header: title + actions -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Theme.Settings.HeaderBg}"
                                BorderBrush="{DynamicResource Theme.Settings.HeaderBorder}"
                                BorderThickness="0,0,0,1.3"
                                CornerRadius="8,8,0,0"
                                Padding="24,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Settings"
                                           Style="{StaticResource SettingsPageHeading}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Beta updates"
                                                   Style="{StaticResource SettingsToggleRowLabel}"
                                                   Margin="0,0,8,0"/>
                                        <ToggleButton x:Name="BetaUpdatesToggle"
                                                      Style="{StaticResource SettingsToggleSwitch}"
                                                      VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="CheckUpdatesButton"
                                            Content="Check &amp; run updates"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Background="{DynamicResource Theme.Button.SecondaryBg}"
                                            Foreground="{DynamicResource Theme.Button.SecondaryFg}"
                                            BorderBrush="{DynamicResource Theme.Button.SecondaryBorder}"
                                            Click="CheckUpdatesButton_Click"/>
                                    <Button x:Name="SaveButton"
                                            Content="Save &amp; Back to Kiosk"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Margin="12,0,0,0"
                                            Click="SaveButton_Click"/>
                                    <Button x:Name="ExitToWindowsButton"
                                            Content="Exit to Windows"
                                            Style="{StaticResource SecondaryActionButton}"
                                            Background="{DynamicResource Theme.Button.SecondaryBg}"
                                            Foreground="{DynamicResource Theme.Button.SecondaryFg}"
                                            BorderBrush="{DynamicResource Theme.Button.SecondaryBorder}"
                                            Margin="12,0,0,0"
                                            Click="ExitToWindows_Click"/>
                                </StackPanel>
                                <Border x:Name="UpdateStatusPopup"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,12,0,0"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource Theme.Settings.CardBg}"
                                        BorderBrush="{DynamicResource Theme.Settings.CardBorder}"
                                        BorderThickness="1.3"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="UpdateStatusPopupText"
                                               Style="{StaticResource SettingsItemLabel}"
                                               Text="No update found right now."/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Config + Pin | Gestures | MQTT -->
                        <Grid Grid.Row="1" Margin="24,20,24,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Config" Style="{StaticResource SettingsSectionHeading}"/>
                                <TextBlock Text="Kiosk URL" Style="{StaticResource SettingsItemLabel}"/>
                                <TextBox x:Name="UrlBox" Text="http://homeassistant.local:8123" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Ignore HTTPS cert warnings"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="IgnoreCertificateErrorsToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Do Not Disturb (quiet hours)"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="DoNotDisturbToggle"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsToggleSwitch}"
                                                   VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Device name" Style="{StaticResource SettingsItemLabel}"/>
                                <TextBox x:Name="DeviceNameBox" Text="living-room-kiosk" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,10" TextChanged="DeviceNameBox_TextChanged"/>

                                <TextBlock Text="Theme" Style="{StaticResource SettingsItemLabel}"/>
                                <ComboBox x:Name="ThemeModeCombo"
                                          Style="{StaticResource SettingsComboBox}"
                                          Margin="0,0,0,12"
                                          SelectionChanged="ThemeModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Auto (Windows)" Tag="auto"/>
                                    <ComboBoxItem Content="Light" Tag="light"/>
                                    <ComboBoxItem Content="Dark" Tag="dark"/>
                                </ComboBox>

                                <TextBlock Text="Brightness (%)" Style="{StaticResource SettingsItemLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="DefaultBrightnessSlider"
                                            Grid.Column="0"
                                            Style="{StaticResource SettingsSlider}"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            ValueChanged="DefaultBrightnessSlider_ValueChanged"/>
                                    <TextBlock x:Name="DefaultBrightnessValueText"
                                               Grid.Column="1"
                                               Width="40"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsItemLabel}"
                                               Text="100"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Allow 0% brightness"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="AllowZeroBrightnessToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="AllowZeroBrightnessToggle_Changed"
                                                  Unchecked="AllowZeroBrightnessToggle_Changed"/>
                                </Grid>

                                <TextBlock Text="Volume (%)" Style="{StaticResource SettingsItemLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumePercentSlider"
                                            Grid.Column="0"
                                            Style="{StaticResource SettingsSlider}"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            ValueChanged="VolumePercentSlider_ValueChanged"/>
                                    <TextBlock x:Name="VolumePercentValueText"
                                               Grid.Column="1"
                                               Width="40"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsItemLabel}"
                                               Text="100"/>
                                </Grid>

                                <TextBlock Text="Playback device" Style="{StaticResource SettingsItemLabel}"/>
                                <ComboBox x:Name="PlaybackDeviceCombo"
                                          Style="{StaticResource SettingsComboBox}"
                                          Margin="0,0,0,10"
                                          SelectionChanged="PlaybackDeviceCombo_SelectionChanged"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Enable mic"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="EnableMicToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="EnableMicToggle_Changed"
                                                  Unchecked="EnableMicToggle_Changed"/>
                                </Grid>

                                <StackPanel x:Name="InputDevicePanel" Margin="0,0,0,10">
                                    <TextBlock Text="Input device" Style="{StaticResource SettingsItemLabel}"/>
                                    <ComboBox x:Name="InputDeviceCombo"
                                              Style="{StaticResource SettingsComboBox}"/>
                                </StackPanel>

                                <StackPanel x:Name="CameraDevicePanel" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="Camera device" Style="{StaticResource SettingsItemLabel}"/>
                                    <ComboBox x:Name="CameraDeviceCombo"
                                              Style="{StaticResource SettingsComboBox}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Start on boot"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="AutoStartToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Respect active hours"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="WindowsUpdateRespectActiveHoursToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="When on, a required reboot after Windows Update is deferred to outside active hours; when off, reboot is scheduled in 30 seconds."
                                           Style="{StaticResource SettingsHintText}"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="Pin" Style="{StaticResource SettingsSectionHeading}" Margin="0,16,0,10"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Pin protection"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="PinProtectionToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="PinProtectionToggle_Changed"
                                                  Unchecked="PinProtectionToggle_Changed"/>
                                </Grid>

                                <StackPanel x:Name="PinProtectedFieldsPanel" Visibility="Visible">
                                    <TextBlock Text="Settings PIN" Style="{StaticResource SettingsItemLabel}"/>
                                    <local:SecretInputControl x:Name="SettingsPinBox"
                                                              Margin="0,0,0,10"/>

                                    <TextBlock Text="PIN hint (optional)" Style="{StaticResource SettingsItemLabel}"/>
                                    <TextBox x:Name="PinHintBox"
                                             Style="{StaticResource RoundedTextBox}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Text="Add a verification question for if you've forgotten the pin and need to reset it."
                                               Style="{StaticResource SettingsItemLabel}"
                                               TextWrapping="Wrap"/>
                                    <TextBox x:Name="PinResetQuestionBox"
                                             Style="{StaticResource RoundedTextBox}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="PIN reset answer" Style="{StaticResource SettingsItemLabel}"/>
                                    <local:SecretInputControl x:Name="PinResetAnswerBox"
                                                              Margin="0,0,0,10"/>
                                </StackPanel>

                                <TextBlock Text="Buttons" Style="{StaticResource SettingsSectionHeading}" Margin="0,16,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Settings button"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="ShowSettingsButtonToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="If off, open Settings only via a configured gesture action set to Settings (or MQTT open settings if enabled)."
                                           FontSize="11"
                                           Foreground="{DynamicResource Theme.Settings.FgMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Custom button"
                                               Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="CustomButtonEnabledToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="CustomButtonEnabledToggle_Changed"
                                                  Unchecked="CustomButtonEnabledToggle_Changed"/>
                                </Grid>
                                <StackPanel x:Name="CustomButtonOptionsPanel" Margin="16,0,0,4" Visibility="Collapsed">
                                    <TextBlock Text="Icon (mdi:name)" Style="{StaticResource SettingsItemLabel}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomButtonIconBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 TextChanged="CustomButtonIconBox_TextChanged"/>
                                        <Border Grid.Column="1"
                                                Width="40"
                                                Height="40"
                                                Margin="8,0,0,0"
                                                Background="{DynamicResource Theme.Settings.InputBg}"
                                                BorderBrush="{DynamicResource Theme.Settings.InputBorder}"
                                                BorderThickness="1.4"
                                                CornerRadius="6">
                                            <materialIcons:MaterialIcon x:Name="CustomButtonIconPreview"
                                                                        Kind="ButtonPointer"
                                                                        Width="22"
                                                                        Height="22"
                                                                        Foreground="{DynamicResource Theme.Settings.InputFg}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Action" Style="{StaticResource SettingsItemLabel}"/>
                                    <ComboBox x:Name="CustomButtonActionCombo"
                                              Style="{StaticResource SettingsComboBox}"
                                              Margin="0,0,0,10"
                                              SelectionChanged="CustomButtonAction_SelectionChanged">
                                        <ComboBoxItem Content="Reload" Tag="reload"/>
                                        <ComboBoxItem Content="Clear cache and reload" Tag="clearcache_reload"/>
                                        <ComboBoxItem Content="Settings" Tag="settings"/>
                                        <ComboBoxItem Content="MQTT message" Tag="mqtt"/>
                                        <ComboBoxItem Content="MQTT reconnect" Tag="mqtt_publish"/>
                                        <ComboBoxItem Content="Bring up keyboard" Tag="keyboard"/>
                                    </ComboBox>
                                    <StackPanel x:Name="CustomButtonMqttTopicPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                        <TextBlock x:Name="CustomButtonMqttTopicHeadingText" Text="MQTT topic" Style="{StaticResource SettingsItemLabel}"/>
                                        <TextBlock x:Name="CustomButtonMqttPrefixText" Style="{StaticResource SettingsItemLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CustomButtonMqttTopicBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,0"/>
                                        <TextBlock x:Name="CustomButtonMqttReconnectHelpText"
                                                   Visibility="Collapsed"
                                                   TextWrapping="Wrap"
