<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Default to DLL output for Google Drive reliability. Set /p:BundleAsExe=true when ready to ship an .exe. -->
    <UseAppHost Condition="'$(BundleAsExe)' == 'true'">true</UseAppHost>
    <UseAppHost Condition="'$(BundleAsExe)' != 'true'">false</UseAppHost>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>3.12.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\light_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="YamlDotNet" Version="16.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HAWinKiosk.Mqtt\HAWinKiosk.Mqtt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Raleway-VariableFont_wght.ttf" />
    <Resource Include="..\..\dark_logo.png" Link="dark_logo.png" />
    <Resource Include="..\..\light_logo.png" Link="light_logo.png" />
    <None Include="..\..\dark_logo.ico" Link="dark_logo.ico" />
    <None Include="..\..\light_logo.ico" Link="light_logo.ico" />
  </ItemGroup>

</Project>
