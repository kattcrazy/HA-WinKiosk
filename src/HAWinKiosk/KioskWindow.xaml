                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Memory usage" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttSensorMemoryToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Monitor state" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttSensorMonitorOnToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Current URL" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttSensorCurrentUrlToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel x:Name="CameraStreamPanel" Visibility="Collapsed">
                                    <settings:SettingsSelectRow x:Name="CameraStreamModeSelect"
                                                                Label="Camera stream"
                                                                SelectionChanged="CameraStreamModeSelect_SelectionChanged">
                                        <ComboBoxItem Content="Off" Tag="off"/>
                                        <ComboBoxItem Content="HA camera entity" Tag="ha"/>
                                        <ComboBoxItem Content="MJPEG stream for NVR" Tag="mjpeg"/>
                                    </settings:SettingsSelectRow>
                                    <StackPanel x:Name="CameraStreamOptionsPanel" Margin="16,0,0,4" Visibility="Collapsed">
                                        <settings:SettingsSliderRow x:Name="CameraFpsSlider"
                                                                    Label="FPS"
                                                                    Minimum="1"
                                                                    Maximum="15"
                                                                    Value="5"/>
                                        <StackPanel x:Name="CameraMjpegOptionsPanel" Visibility="Collapsed">
                                            <TextBlock Text="Port" Style="{StaticResource SettingsItemLabel}"/>
                                            <settings:SettingsNumericInput x:Name="CameraMjpegPortBox"
                                                                           Text="8081"
                                                                           MaxLength="5"
                                                                           Margin="0,0,0,10"
                                                                           TextChanged="CameraMjpegPortBox_TextChanged"/>
                                            <TextBlock Text="Stream URL" Style="{StaticResource SettingsItemLabel}"/>
                                            <TextBlock x:Name="CameraMjpegUrlText"
                                                       Style="{StaticResource SettingsItemLabel}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6"/>
                                            <settings:SettingsNote Text="In Windows Settings, make sure to make the kiosk's IP static otherwise the url will change and the stream will not be accessible from the old url"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Commands" Style="{StaticResource SettingsSubSectionHeading}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Shutdown" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdShutdownToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Restart" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdRestartToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="System sleep" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdSleepToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Monitor sleep" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdMonSleepToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Monitor wake" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdMonWakeToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Refresh kiosk" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdRefreshToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clear kiosk cache" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdClearCacheToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Open settings" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdOpenSettingsToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Close settings" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdCloseSettingsToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Run Windows updates" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdWindowsUpdateToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center" Checked="MqttCmdWindowsUpdateToggle_Changed" Unchecked="MqttCmdWindowsUpdateToggle_Changed"/>
                                </Grid>
                                <StackPanel x:Name="MqttCmdWindowsUpdateNotePanel" Margin="16,0,0,8" Visibility="Collapsed">
                                    <TextBlock Text="If a reboot is required, timing follows Config -> Respect active hours."
                                               Style="{StaticResource SettingsHintText}"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PowerShell command" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdPowerShellToggle" Grid.Column="1" Style="{StaticResource SettingsToggleSwitch}" VerticalAlignment="Center" Checked="MqttCmdPowerShellToggle_Changed" Unchecked="MqttCmdPowerShellToggle_Changed"/>
                                </Grid>
                                <StackPanel x:Name="MqttCmdPowerShellCommandPanel" Margin="16,0,0,4" Visibility="Collapsed">
                                    <StackPanel x:Name="MqttCmdPowerShellRowsPanel"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Navigate" Style="{StaticResource SettingsToggleRowLabel}"/>
                                    <ToggleButton x:Name="MqttCmdNavigateToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="MqttCmdNavigateToggle_Changed"
                                                  Unchecked="MqttCmdNavigateToggle_Changed"/>
                                </Grid>
                                <StackPanel x:Name="MqttCmdNavigateOptionsPanel" Margin="16,0,0,4" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="MQTT topic"
                                                   Style="{StaticResource SettingsItemLabel}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="MqttNavigateTopicPreviewText"
                                                   Style="{StaticResource SettingsItemLabel}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="See repo README for how to use Navigate from Home Assistant."
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.Settings.FgMuted}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
